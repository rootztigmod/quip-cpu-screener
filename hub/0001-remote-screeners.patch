 // (`--worker-listen`) over a small framed TCP protocol, usually through an SSH tunnel. A worker runs the
 // unchanged solve (probe screens, full solve, re-rolls); the hub keeps the CPU scouts, the best-first pool
 // and the coordinator session. Frame: kind u8, length u32 LE, body.
+
+// Hub-side client of the CPU screener broker (see the quip-cpu-screener repo). Off unless QUIP_SCREENERS is set.
+mod screen_remote {
+    use std::io::{Read, Write};
+    use std::net::{TcpStream, ToSocketAddrs};
+    use std::time::{Duration, Instant};
+    const MAGIC: u32 = 0x5153_5231;
+    const K_FAMILY: u8 = 8;
+    const K_SLOT_REQ: u8 = 9;
+    const K_SLOT_OK: u8 = 10;
+    const K_SLOT_NONE: u8 = 11;
+    const K_SCREEN: u8 = 12;
+    const K_SCREEN_REPLY: u8 = 13;
+    const K_HUB_HELLO: u8 = 14;
+    fn put(w: &mut impl Write, kind: u8, body: &[u8]) -> std::io::Result<()> {
+        let mut b = Vec::with_capacity(5 + body.len());
+        b.push(kind); b.extend_from_slice(&(body.len() as u32).to_le_bytes()); b.extend_from_slice(body);
+        w.write_all(&b)?; w.flush()
+    }
+    fn get(r: &mut impl Read) -> std::io::Result<(u8, Vec<u8>)> {
+        let mut h = [0u8; 5]; r.read_exact(&mut h)?;
+        let n = u32::from_le_bytes([h[1], h[2], h[3], h[4]]) as usize;
+        if n > (64 << 20) { return Err(std::io::Error::new(std::io::ErrorKind::InvalidData, "frame too large")); }
+        let mut body = vec![0u8; n]; r.read_exact(&mut body)?; Ok((h[0], body))
+    }
+    pub struct Conn { s: TcpStream }
+    pub fn token() -> [u8; 32] {
+        let mut t = [0u8; 32];
+        if let Ok(v) = std::env::var("QUIP_SCREENER_TOKEN") { let b = v.trim().as_bytes(); t[..b.len().min(32)].copy_from_slice(&b[..b.len().min(32)]); }
+        t
+    }
+    /// The salt family in the same layout as the broker's WELCOME frame (status 0, epoch, params, nodes, native edges, model).
+    pub fn family_body(params: &[u8], nodes: &[u32], edges: &[(u32, u32)], model: &[f64]) -> (u64, Vec<u8>) {
+        use std::hash::{Hash, Hasher};
+        let mut h = std::collections::hash_map::DefaultHasher::new();
+        params.hash(&mut h); nodes.hash(&mut h); edges.hash(&mut h); for m in model { m.to_bits().hash(&mut h); }
+        let epoch = h.finish();
+        let mut o = vec![0u8];
+        o.extend_from_slice(&epoch.to_le_bytes());
+        o.extend_from_slice(&(params.len() as u32).to_le_bytes()); o.extend_from_slice(params);
+        o.extend_from_slice(&(nodes.len() as u32).to_le_bytes()); for n in nodes { o.extend_from_slice(&n.to_le_bytes()); }
+        o.extend_from_slice(&(edges.len() as u32).to_le_bytes()); for (u, v) in edges { o.extend_from_slice(&u.to_le_bytes()); o.extend_from_slice(&v.to_le_bytes()); }
+        for m in model { o.extend_from_slice(&m.to_le_bytes()); }
+        (epoch, o)
+    }
+    pub fn connect(addr: &str, fam: &[u8]) -> Result<Conn, String> {
+        let sa = addr.to_socket_addrs().map_err(|e| e.to_string())?.next().ok_or("no address")?;
+        let mut s = TcpStream::connect_timeout(&sa, Duration::from_secs(3)).map_err(|e| e.to_string())?;
+        s.set_nodelay(true).ok();
+        let mut hello = Vec::new(); hello.extend_from_slice(&MAGIC.to_le_bytes()); hello.extend_from_slice(&token());
+        put(&mut s, K_HUB_HELLO, &hello).map_err(|e| e.to_string())?;
+        put(&mut s, K_FAMILY, fam).map_err(|e| e.to_string())?;
+        Ok(Conn { s })
+    }
+    impl Conn {
+        /// Ask for a free screener. `Some(n)` = suggested batch size, `None` = none free right now.
+        pub fn slot(&mut self, wait_ms: u32) -> Result<Option<usize>, String> {
+            self.s.set_read_timeout(Some(Duration::from_secs(8))).ok();
+            put(&mut self.s, K_SLOT_REQ, &wait_ms.to_le_bytes()).map_err(|e| e.to_string())?;
+            let (k, b) = get(&mut self.s).map_err(|e| e.to_string())?;
+            match k { K_SLOT_OK if b.len() >= 4 => Ok(Some(u32::from_le_bytes([b[0], b[1], b[2], b[3]]) as usize)), K_SLOT_NONE => Ok(None), _ => Err(format!("unexpected frame {k}")) }
+        }
+        /// Send a batch. `Ok(Ok(passes))` = (index in batch, screener score); `Ok(Err(status))` = the broker could not do it.
+        pub fn screen(&mut self, id: u64, keep: f32, nonces: &[[u8; 32]], stopped: &dyn Fn() -> bool) -> Result<Result<Vec<(u32, f64)>, u8>, String> {
+            let mut b = Vec::with_capacity(16 + nonces.len() * 32);
+            b.extend_from_slice(&id.to_le_bytes()); b.extend_from_slice(&keep.to_le_bytes()); b.extend_from_slice(&(nonces.len() as u32).to_le_bytes());
+            for n in nonces { b.extend_from_slice(n); }
+            put(&mut self.s, K_SCREEN, &b).map_err(|e| e.to_string())?;
+            self.s.set_read_timeout(Some(Duration::from_secs(1))).ok();
+            let t0 = Instant::now();
+            loop {
+                let mut h = [0u8; 5];
+                match self.s.read_exact(&mut h) {
+                    Ok(()) => {
+                        let n = u32::from_le_bytes([h[1], h[2], h[3], h[4]]) as usize;
+                        if n > (64 << 20) { return Err("frame too large".into()); }
+                        let mut body = vec![0u8; n];
+                        self.s.set_read_timeout(Some(Duration::from_secs(10))).ok();
+                        self.s.read_exact(&mut body).map_err(|e| e.to_string())?;
+                        if h[0] != K_SCREEN_REPLY || body.len() < 13 { return Err("bad reply".into()); }
+                        let rid = u64::from_le_bytes(body[..8].try_into().unwrap());
+                        if rid != id { return Err("reply id mismatch".into()); }
+                        let st = body[8]; let k = u32::from_le_bytes(body[9..13].try_into().unwrap()) as usize;
+                        if st != 0 { return Ok(Err(st)); }
+                        if body.len() < 13 + k * 12 { return Err("short reply".into()); }
+                        let mut v = Vec::with_capacity(k);
+                        for j in 0..k { let o = 13 + j * 12; v.push((u32::from_le_bytes(body[o..o + 4].try_into().unwrap()), f64::from_le_bytes(body[o + 4..o + 12].try_into().unwrap()))); }
+                        return Ok(Ok(v));
+                    }
+                    Err(e) if e.kind() == std::io::ErrorKind::WouldBlock || e.kind() == std::io::ErrorKind::TimedOut => {
+                        if stopped() || t0.elapsed() > Duration::from_secs(90) { return Err("screen timed out".into()); }
+                    }
+                    Err(e) => return Err(e.to_string()),
+                }
+            }
+        }
+    }
